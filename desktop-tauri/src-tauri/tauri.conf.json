{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SweetCord Tauri Preview",
  "version": "0.1.0",
  "identifier": "app.sweetcord.tauri-preview",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SweetCord",
        "url": "about:blank",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
