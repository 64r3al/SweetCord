{
  "name": "sweetcord-desktop-shell",
  "version": "0.3.0",
  "private": true,
  "description": "A lightweight SweetCord desktop shell for Discord's own web app",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win nsis",
    "prepare:electron": "node ./node_modules/electron/install.js",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.sweetcord.desktop",
    "productName": "SweetCord",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "lean-mode.cjs",
      "resource-policy.cjs",
      "package.json"
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
