# Supabase project URL (public; does not grant database access on its own)
VITE_SUPABASE_URL=

# Public Discord OAuth application ID. It is not a secret.
VITE_DISCORD_CLIENT_ID=

# Must exactly match a redirect URI registered in the Discord Developer Portal.
VITE_DISCORD_REDIRECT_URI=http://127.0.0.1:5173/

# Leave blank for a local-only profile test using the Vite development server.
# For a deployed profile-preview backend, use its HTTPS function URL instead.
VITE_DISCORD_EXCHANGE_ENDPOINT=

# LOCAL-ONLY TEST: Discord OAuth client secret, used by the Vite dev server only.
# Do not prefix this with VITE_ and never commit a real value.
DISCORD_CLIENT_SECRET=

# Public Supabase publishable key (safe for client use when RLS/access controls are configured).
# Do not put a Supabase secret/service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
