# Public Discord OAuth application ID. It is not a secret.
VITE_DISCORD_CLIENT_ID=

# Must exactly match the redirect URI configured in the Discord Developer Portal.
VITE_DISCORD_REDIRECT_URI=http://127.0.0.1:5173/

# Backend URL implementing POST /auth/discord/exchange.
# The backend must exchange authorization codes server-side and must never return
# or log Discord user tokens to the frontend.
VITE_AUTH_API_BASE_URL=

# OAuth is intentionally disabled until the values above are configured.
